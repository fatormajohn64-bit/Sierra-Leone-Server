# ==========================================
# SIERRA LEONE SERVER (SLS) - CONFIGURATION
# ==========================================

# 1. System Environment
NODE_ENV=development
PLATFORM_MODE=linux # Options: linux, termux, docker

# 2. Network Ports
API_PORT=4000
DASHBOARD_PORT=3000
DAEMON_PORT=4001

# 3. Security (MUST CHANGE IN PRODUCTION)
JWT_SECRET=super_secret_sls_key_change_me_immediately
JWT_EXPIRES_IN=24h

# 4. PostgreSQL Database
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://sls_admin:sls_secure_password@localhost:5432/sls_core

# 5. Redis (For caching and background jobs)
REDIS_URL=redis://localhost:6379

# 6. System Paths
DOCKER_SOCKET=/var/run/docker.sock
NGINX_SITES_PATH=/etc/nginx/conf.d
BACKUP_STORAGE_PATH=/var/sls/backups
